<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Laya.Cli</RootNamespace>
    <!-- Not "layar": AssemblyName defaults PackageId too, and "layar" collides case-insensitively
         with Layar.Core's PackageId "Layar" ("Ambiguous project name 'layar'"). PackAsTool +
         ToolCommandName below is what actually gives users the "layar" command, same pattern as
         mermaider's Mermaider.Cli (ToolCommandName "mermaid"). -->
    <PackageId>Layar.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>layar</ToolCommandName>
    <Description>Layar CLI: run typed decisions from the command line, and benchmark the ONNX and TorchSharp backends against each other.</Description>
    <PackageTags>decision-model;classification;calibration;nlp;cli;tool</PackageTags>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\nuget-icon.png" Pack="true" PackagePath="nuget-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Layar.Core\Layar.Core.csproj" />
    <ProjectReference Include="..\Laya.Tokenization\Laya.Tokenization.csproj" />
    <ProjectReference Include="..\Laya.Onnx\Laya.Onnx.csproj" />
    <ProjectReference Include="..\Laya.TorchSharp\Laya.TorchSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TorchSharp-cpu" />
  </ItemGroup>

</Project>
