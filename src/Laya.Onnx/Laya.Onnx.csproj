<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Laya.Onnx</RootNamespace>
    <AssemblyName>Layar.Onnx</AssemblyName>
    <PackageId>Layar.Onnx</PackageId>
    <Description>ONNX Runtime backend for Layar's decision model — one of two interchangeable IDecisionBackend implementations (the other is Layar.TorchSharp), so the two can be benchmarked against each other.</Description>
    <PackageTags>decision-model;onnx;onnxruntime</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\nuget-icon.png" Pack="true" PackagePath="nuget-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Layar.Core\Layar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

</Project>
