<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Nullean.Make.Fs reads the target descriptions from the /// comments in Program.fs -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- under Central Package Management the F# SDK adds no implicit FSharp.Core -->
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Nullean.Make.Fs" />
    <PackageReference Include="Proc.Fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Paths.fs" />
    <Compile Include="Versions.fs" />
    <Compile Include="Documentation.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
