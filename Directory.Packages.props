<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime dependencies -->
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.12" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" />
    <PackageVersion Include="TorchSharp" Version="0.107.0" />
    <PackageVersion Include="TorchSharp-cpu" Version="0.107.0" />
    <PackageVersion Include="TorchSharp.PyBridge" Version="1.4.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="TUnit" Version="1.17.25" />
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="Verify.TUnit" Version="31.13.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Benchmark dependencies -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test infrastructure -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="2.3.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Build script dependencies -->
    <!-- Nullean.Make.Fs needs FSharp.Core 11.0.100 or later; only build/scripts uses it -->
    <PackageVersion Include="FSharp.Core" Version="11.0.100" />
    <PackageVersion Include="Nullean.Make.Fs" Version="0.25.0" />
    <!-- the current release, which Nullean.Make.Fs would otherwise resolve at its 0.17.0 floor -->
    <PackageVersion Include="Proc.Fs" Version="0.18.0" />
  </ItemGroup>
</Project>
